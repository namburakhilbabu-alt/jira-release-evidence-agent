# Copy to .env and fill in:   cp .env.example .env
# .env is never committed. Don't paste these values anywhere.

# --- Jira ---
# start of the address bar when you open Jira
JIRA_URL=https://your-site.atlassian.net
# the email you log in to Atlassian with
JIRA_EMAIL=you@example.com
# https://id.atlassian.com/manage-profile/security/api-tokens -> Create API token
JIRA_API_TOKEN=
# the letters in front of issue numbers (TYN-1 -> TYN)
JIRA_PROJECT=TYN
JIRA_ISSUE_TYPE=Task
JIRA_LINK_TYPE=Relates

# --- what to assess ---
DATASET_LABEL=tyn-release-assessment-v2
TARGET_RELEASE=R2.4

# --- AI model (any OpenAI-compatible API) ---
# Free: Google AI Studio. https://aistudio.google.com/apikey -> Create API key
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# pick a Flash-Lite model from the free tier list in AI Studio (more requests per day);
# python -m app.check prints the model names your key can use
LLM_MODEL=gemini-3.5-flash-lite
# free tier is about 15 requests/minute, so wait a few seconds between calls
LLM_SECONDS_BETWEEN_CALLS=5
# most model turns for one requirement
MAX_STEPS=20
